{
  "name": "pulse",
  "version": "0.1.0",
  "description": "Verteilte Monitoring-Plattform",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker-process.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-process.js",
    "test": "tap --disable-coverage --jobs=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migration:generate": "node scripts/generate-migration.mjs",
    "migration:run": "node --import tsx ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts"
  },
  "dependencies": {
    "@fastify/awilix": "^8.2.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@platformatic/prom-client": "^1.0.0",
    "awilix": "^13.0.5",
    "bullmq": "^6.3.6",
    "fastify": "^5.12.5",
    "fastify-metrics": "^14.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tap": "^21.8.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
